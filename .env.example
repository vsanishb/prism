# Prism environment template. `scripts/prism.py setup` generates a complete local .env.
# Use this file as a reference for deployed environments. Never commit .env.
# Values are intentionally blank: there are no default credentials.

PRISM_ENVIRONMENT=

# --- Database ---
# Pooled Neon endpoint, runtime role for services/core.
PRISM_CORE_DB_URL=
PRISM_CORE_DB_USER=
PRISM_CORE_DB_PASSWORD=
# Direct (non-pooled) Neon endpoint, owner role. Used only by the migration step.
PRISM_MIGRATION_DB_URL=
PRISM_MIGRATION_DB_USER=
PRISM_MIGRATION_DB_PASSWORD=
# Pooled Neon endpoint, runtime role for services/ai (knowledge schema only).
PRISM_AI_DB_URL=
# Server used by integration tests to create disposable databases. Never a shared server.
PRISM_TEST_ADMIN_DB_URL=
PRISM_TEST_ADMIN_DB_USER=
PRISM_TEST_ADMIN_DB_PASSWORD=

# --- Service-to-service authentication ---
# Paths to an ES256 key pair. core signs, ai verifies.
PRISM_SERVICE_JWT_PRIVATE_KEY_PATH=
PRISM_SERVICE_JWT_PUBLIC_KEY_PATH=

# --- Service addresses ---
PRISM_AI_BASE_URL=
PRISM_CORE_BASE_URL=
PRISM_WEB_BASE_URL=

# --- Security ---
# Base64-encoded random key for sign-in throttling.
PRISM_THROTTLE_HMAC_KEY=
# true everywhere except local HTTP development.
PRISM_COOKIE_SECURE=
# true only when a trusted proxy sets X-Forwarded-For and core cannot be reached directly.
PRISM_FORWARDED_HEADER_TRUSTED=

# --- First administrator ---
# Creates a one-time invitation on an empty system. The password is set through the link.
PRISM_BOOTSTRAP_ADMIN_EMAIL=
PRISM_BOOTSTRAP_INVITE_FILE=

# --- Synthetic data (local only) ---
PRISM_SEED_CREDENTIALS_FILE=

# --- Added by later milestones ---
# Document storage directory. An S3-compatible store replaces this in Milestone 9.
PRISM_DOCUMENT_STORE_PATH=
# Temporal (Milestone 3)
# Optional. Defaults suit the local Temporal server.
PRISM_TEMPORAL_TARGET=127.0.0.1:7233
PRISM_INFORMATION_WAIT=14d
# AI models (Milestone 3)
OPENROUTER_API_KEY=
