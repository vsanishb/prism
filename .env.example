# Prism environment template. Copy to .env and fill in values. Never commit .env.
# Values are intentionally blank: there are no default credentials.
# Variables are introduced by the milestone noted beside each group.

# --- Database (Milestone 1) ---
# Pooled Neon endpoint, runtime role for services/core.
PRISM_CORE_DB_URL=
PRISM_CORE_DB_USER=
PRISM_CORE_DB_PASSWORD=
# Direct (non-pooled) Neon endpoint, owner role. Used only by the migration step.
PRISM_MIGRATION_DB_URL=
PRISM_MIGRATION_DB_USER=
PRISM_MIGRATION_DB_PASSWORD=
# Pooled Neon endpoint, runtime role for services/ai (knowledge schema only).
PRISM_AI_DB_URL=

# --- Service-to-service authentication (Milestone 1) ---
# Paths to an ES256 key pair generated locally. core signs, ai verifies.
PRISM_SERVICE_JWT_PRIVATE_KEY_PATH=
PRISM_SERVICE_JWT_PUBLIC_KEY_PATH=
PRISM_AI_BASE_URL=

# --- First administrator (Milestone 1) ---
# Used once to create the initial admin invitation. The password is set through the invitation.
PRISM_BOOTSTRAP_ADMIN_EMAIL=

# --- Document storage (Milestone 2) ---
# filesystem (local development) or s3 (deployed environments).
PRISM_DOCUMENT_STORE=
PRISM_DOCUMENT_STORE_PATH=

# --- Temporal (Milestone 3) ---
PRISM_TEMPORAL_ADDRESS=
PRISM_TEMPORAL_NAMESPACE=

# --- AI models (Milestone 3) ---
OPENROUTER_API_KEY=
